# FedEx MPS API 返回的 JSON 文件
JSON_FILE = r"C:\Users\pengj8\AppData\Local\Programs\Microsoft VS Code\mps_result.json"

# 输出文件
OUTPUT_EXCEL = r"FedEx_MPS_子单状态.xlsx"
